# Bookly Environment Configuration Template
# Copy this file to '.env' and populate with your credentials. Do not commit '.env' to VCS.

# --- Database (PostgreSQL) ---
DB_URL=jdbc:postgresql://localhost:5432/bookly_db
DB_USERNAME=postgres
DB_PASSWORD=your_secure_db_password

# --- Cache & Sessions (Redis) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Security & JWT ---
# JWT_SECRET must be a secure base64-encoded key of at least 64 bytes (512 bits)
# Generate with: openssl rand -base64 64
JWT_SECRET=

# Default TTL configuration (in milliseconds)
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# --- SMTP Mail Settings (e.g. Brevo / Sendinblue) ---
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=noreply@example.com
MAIL_PASSWORD=your_smtp_relay_key
MAIL_FROM=noreply@example.com

# --- OAuth2 Credentials ---
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# --- Ingress / Proxy Settings ---
# In production, set this to the IP or CIDR range of your load balancer (e.g., AWS ALB, Nginx, Cloudflare)
# to trust X-Forwarded-For headers for accurate rate-limiting and audit logging.
TRUSTED_PROXY_CIDR=
